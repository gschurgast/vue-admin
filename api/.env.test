# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Dedicated test database (created via `docker compose exec database psql -U app -d postgres -c 'CREATE DATABASE app_test;'`)
DATABASE_URL="postgresql://app:!ChangeMe!@database:5432/app_test?serverVersion=16&charset=utf8"

# Messenger transport DSN — overridden to in-memory in messenger.yaml `when@test`
MESSENGER_TRANSPORT_DSN=in-memory://
